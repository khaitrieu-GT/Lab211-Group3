  <diagram name="Bản sao của Trang-1" id="ZzpRS4vsgXyZtq_DcCGq">
    <mxGraphModel grid="1" page="1" gridSize="1" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="4681" pageHeight="3300" math="0" shadow="0">
      <root>
        <mxCell id="0zFkCI7xuW-cI8v8_5eR-0" />
        <mxCell id="0zFkCI7xuW-cI8v8_5eR-1" parent="0zFkCI7xuW-cI8v8_5eR-0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction LR\n\n    %% ==========================================\n    %% VIEW – giao dien console (chi nhap / xuat)\n    %% ==========================================\n    class BaseView {\n        &lt;&lt;abstract&gt;&gt;\n        +printHeader(title: String) void\n        +printSection(title: String) void\n        +printList(list: List, emptyMsg: String) void\n        +inputChoice() int\n        +inputString(prompt: String) String\n        +inputInt(prompt: String) int\n    }\n\n    class AdminView {\n        +showMainMenu(title: String) int\n        +showUserMenu() int\n        +showStadiumMenu() int\n        +showTeamMenu() int\n        +showMonitorMenu() int\n        +showCancellationMenu() int\n        +displayUsers(users: List) void\n        +displayStadiums(stadiums: List) void\n        +displayStadiumLayout(stadium: Stadium) void\n        +displayAuditLogs(logs: List) void\n        +inputId(prompt: String) String\n        +inputNonEmpty(prompt: String) String\n        +inputMoney(prompt: String) BigDecimal\n        +inputIntInRange(prompt: String, min: int, max: int) int\n        +confirm(msg: String) boolean\n        +printSuccess(msg: String) void\n        +printError(msg: String) void\n        +withUnread(title: String, count: int) String\n    }\n\n    class OrderView {\n        +displayHistory(list: List) void\n    }\n\n    class MatchView {\n        +displayMatches(list: List) void\n    }\n\n    class TicketView {\n        +displayCancellations(list: List) void\n    }\n\n    class ReportView {\n        +displayReport(report: SalesReport) void\n    }\n\n    BaseView &lt;|-- AdminView\n    BaseView &lt;|-- OrderView\n    BaseView &lt;|-- MatchView\n    BaseView &lt;|-- TicketView\n    BaseView &lt;|-- ReportView\n\n    %% ==========================================\n    %% CONTROLLER – Dieu khien luong &amp; nghiep vu\n    %% ==========================================\n    class AdminController {\n        -admin: User\n        -userRepo: UserRepository\n        -stadiumRepo: StadiumRepository\n        -sectionRepo: SectionRepository\n        -seatRepo: SeatRepository\n        -teamRepo: TeamRepository\n        -ticketRepo: TicketRepository\n        -matchRepo: MatchRepository\n        -matchController: MatchController\n        -bookingController: BookingController\n        -paymentController: PaymentController\n        -cancellationController: CancellationController\n        -profileController: ProfileController\n        -reportService: ReportService\n        -notificationService: NotificationService\n        -auditService: AuditService\n        -adminView: AdminView\n        -reportView: ReportView\n        -ticketView: TicketView\n        -orderView: OrderView\n        +start() void\n        +getAllUsers() List\n        +searchUsers(keyword: String) List\n        +changeUserStatus(userId: String, status: UserStatus) boolean\n        +createSellerAccount(username: String, password: String, fullName: String, email: String, phone: String) User\n        +updateUserInfo(userId: String, fullName: String, email: String, phone: String) User\n        +deleteUser(userId: String) void\n        +getAllStadiums() List\n        +createStadium(name: String, address: String, city: String, capacity: int) Stadium\n        +updateStadium(stadiumId: String, name: String, address: String, city: String, capacity: int) Stadium\n        +deleteStadium(stadiumId: String) void\n        +getStadiumLayout(stadiumId: String) Stadium\n        +createSection(stadiumId: String, name: String, type: String, capacity: int, basePrice: BigDecimal) Section\n        +updateSection(sectionId: String, name: String, capacity: int) Section\n        +updateSectionStatus(sectionId: String, status: SectionStatus) Section\n        +deleteSection(sectionId: String) void\n        +generateSeats(sectionId: String, row: String, count: int) int\n        +lockSeat(seatId: String) int\n        +unlockSeat(seatId: String) void\n        +updateSeatMaintenance(seatId: String, isMaint: boolean) int\n        +deleteSeat(seatId: String) void\n        +getAllTeams() List\n        +createTeam(name: String, logo: String, country: String) Team\n        +updateTeam(teamId: String, name: String, logo: String, country: String) Team\n        +deleteTeam(teamId: String) void\n        +getAllBookings() List\n        +getAllPayments() List\n        +getAllTransactions() List\n        +getRevenueReport() SalesReport\n        +getAuditLogs() List\n    }\n\n    class CancellationController {\n        -requestRepo: CancellationRequestRepository\n        -ticketRepo: TicketRepository\n        -bookingSeatRepo: BookingSeatRepository\n        -bookingRepo: BookingRepository\n        -seatRepo: SeatRepository\n        -matchController: MatchController\n        -bookingController: BookingController\n        -paymentController: PaymentController\n        -notificationService: NotificationService\n        -auditService: AuditService\n        +createRequest(user: User, eTicketId: String, reason: String) CancellationRequest\n        +getUserRequests(userId: String) List\n        +getPendingRequests() List\n        +getAllRequests() List\n        +approveRequest(admin: User, requestId: String) Payment\n        +rejectRequest(admin: User, requestId: String, note: String) void\n    }\n\n    AdminController --&gt; AdminView : calls\n    AdminController --&gt; OrderView : calls\n    AdminController --&gt; MatchView : calls\n    AdminController --&gt; TicketView : calls\n    AdminController --&gt; ReportView : calls\n    AdminController --&gt; CancellationController : Uy quyen qu ly huy ve\n\n    %% ==========================================\n    %% MODEL – du lieu, truy xuat CSV, dich vu\n    %% ==========================================\n    class BaseEntity {\n        &lt;&lt;abstract&gt;&gt;\n        -id: String\n        +getId() String\n        +setId(id: String) void\n        +toCsvLine() String\n    }\n\n    class User {\n        &lt;&lt;abstract&gt;&gt;\n        -username: String\n        -password: String\n        -fullName: String\n        -email: String\n        -phone: String\n        -avatar: String\n        -status: UserStatus\n        -version: int\n        -createdAt: LocalDateTime\n        -updatedAt: LocalDateTime\n        +getRole()* Role\n        +getPermissions()* List\n        +register() boolean\n        +login(username: String, rawPassword: String) boolean\n        +getProfile() String\n        +updateProfile(fullName: String, email: String, phone: String, avatar: String) void\n        +changePassword(oldRawPassword: String, newRawPassword: String) void\n        +lock() void\n        +unlock() void\n        +markDeleted() void\n        +isActive() boolean\n    }\n\n    class Team {\n        -name: String\n        -logo: String\n        -country: String\n        +getName() String\n        +setName(name: String) void\n        +getLogo() String\n        +setLogo(logo: String) void\n        +getCountry() String\n        +setCountry(country: String) void\n    }\n\n    class Notification {\n        -userId: String\n        -message: String\n        -createdAt: LocalDateTime\n        -isRead: boolean\n        +sendNotification() void\n        +markAsRead() void\n    }\n\n    class AuditLog {\n        -actorUsername: String\n        -action: String\n        -timestamp: LocalDateTime\n        -statusResult: String\n        +logAction() void\n    }\n\n    class Admin {\n        +getRole() Role\n        +getPermissions() List\n    }\n\n    class Buyer {\n        +getRole() Role\n        +getPermissions() List\n    }\n\n    class Seller {\n        +getRole() Role\n        +getPermissions() List\n    }\n\n    class CancellationRequest {\n        -eTicketId: String\n        -userId: String\n        -reason: String\n        -requestDate: LocalDateTime\n        -status: CancellationStatus\n        -handledBy: String\n        -note: String\n        +submitRequest() void\n        +approveRequest(adminId: String) void\n        +rejectRequest(adminId: String, note: String) void\n        +isPending() boolean\n    }\n\n    class Stadium {\n        -name: String\n        -address: String\n        -city: String\n        -capacity: int\n        -createdAt: LocalDateTime\n        -sections: List\n        +addSection(section: Section) void\n        +getSections() List\n        +getAllSeats() List\n        +getAllocatedCapacity() int\n    }\n\n    class Section {\n        -stadiumId: String\n        -name: String\n        -type: String\n        -capacity: int\n        -basePrice: BigDecimal\n        -status: SectionStatus\n        -seats: List\n        +addSeat(seat: Seat) boolean\n        +getAvailableSeats() List\n        +getAllSeats() List\n        +updateSection(name: String, capacity: int) void\n        +updateStatus(status: SectionStatus) void\n        +isActive() boolean\n    }\n\n    class Seat {\n        -sectionId: String\n        -rowNumber: String\n        -seatNumber: int\n        -status: SeatStatus\n        -version: int\n        -updatedAt: LocalDateTime\n        +lock() void\n        +unlock() void\n        +updateStatus(status: SeatStatus) void\n        +isAvailable() boolean\n        +getLabel() String\n    }\n\n    %% Quan hệ kế thừa từ BaseEntity (giống hệt ảnh gốc)\n    BaseEntity &lt;|-- User\n    BaseEntity &lt;|-- Team\n    BaseEntity &lt;|-- Notification\n    BaseEntity &lt;|-- AuditLog\n    BaseEntity &lt;|-- CancellationRequest\n    BaseEntity &lt;|-- Stadium\n    BaseEntity &lt;|-- Section\n    BaseEntity &lt;|-- Seat\n\n    %% Quan hệ kế thừa từ User\n    User &lt;|-- Admin\n    User &lt;|-- Buyer\n    User &lt;|-- Seller\n\n    %% Quan hệ hợp thành (Composition)\n    Stadium *-- Section : Chua\n    Section *-- Seat : Chua\n\n    %% Quan hệ phụ thuộc (uses) đúng như trên ảnh gốc\n    BaseEntity ..&gt; AdminController : uses\n    CancellationRequest ..&gt; CancellationController : uses&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="6blrKFU-xmobwhvvp5Hq-165">
          <mxCell connectable="0" parent="0zFkCI7xuW-cI8v8_5eR-1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;BaseView&lt;/b&gt;" mermaidId="n:BaseView" mermaidBaseStyle="swimlane;html=1;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;horizontal=1;childLayout=stackLayout;startSize=66;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginTop=12;marginBottom=12;stackSpacing=0;swimlaneFillColor=#FDF4FF;whiteSpace=wrap;spacingTop=24;fillColor=#FDF4FF;strokeColor=#E879F9;fontColor=#28253D;fontFamily=Recursive;strokeWidth=2;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="&lt;b&gt;BaseView&lt;/b&gt;" id="6blrKFU-xmobwhvvp5Hq-166">
          <mxCell parent="6blrKFU-xmobwhvvp5Hq-165" style="swimlane;html=1;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;horizontal=1;childLayout=stackLayout;startSize=66;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginTop=12;marginBottom=12;stackSpacing=0;swimlaneFillColor=#FDF4FF;whiteSpace=wrap;spacingTop=24;fillColor=#FDF4FF;strokeColor=#E879F9;fontColor=#28253D;fontFamily=Recursive;strokeWidth=2;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;" vertex="1">
            <mxGeometry height="198" width="369" x="1975" y="2949" as="geometry" />
