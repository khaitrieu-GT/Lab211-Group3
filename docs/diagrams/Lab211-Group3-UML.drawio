chạy đều thuộc package view: Main.java (thư mục gốc – có nhập liệu và menu đặt vé) và Integration/src/view/Main.java (gọi thử đăng nhập). User và AuditLog có trong model nhưng chưa được lớp nào sử dụng; ReportView.displayNotificationBanner() chưa được gọi." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#b7a35a;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="950" height="60" as="geometry"/></mxCell><mxCell id="pemt7g-9" value="VIEW – giao diện console (chỉ nhập / xuất)" style="rounded=1;arcSize=2;whiteSpace=nowrap;html=1;fillColor=#e8f0fb;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=16;fontStyle=1;opacity=50;" vertex="1" parent="1"><mxGeometry x="40" y="134" width="1030" height="176" as="geometry"/></mxCell><mxCell id="pemt7g-3" value="package view" style="shape=folder;tabWidth=104;tabHeight=20;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=0;fontStyle=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=60;" vertex="1" parent="1"><mxGeometry x="70" y="174" width="940" height="116" as="geometry"/></mxCell><mxCell id="pemt7g-4" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Main&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0 0 0 6px;font-size:10px;&quot;&gt;+ main(args)&lt;br&gt;&lt;i style=&quot;color:#a33;&quot;&gt;Main.java (thư mục gốc)&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="90" y="208" width="145" height="64" as="geometry"/></mxCell><mxCell id="pemt7g-5" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Main (Integration)&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0 0 0 6px;font-size:10p