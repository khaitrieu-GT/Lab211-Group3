der:1px solid #999;padding:3px;&quot;&gt;Chức năng (use case)&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:3px;&quot;&gt;Tác nhân&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:3px;&quot;&gt;Mô tả&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:3px;&quot;&gt;Use case con / quan hệ&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;&lt;b&gt;Quản lý trận đấu&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Seller&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Thêm/sửa/xóa/xem trận trong danh sách của SellerController; mở bán (status OPEN), đóng bán (CLOSED).&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;extend: 6 chức năng con&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;&lt;b&gt;Quản lý vé&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Seller&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Thêm, sửa, xem vé của Seller.&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;extend: Thêm, Xem, Sửa vé&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;&lt;b&gt;Bán vé&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Seller&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Tìm vé theo ticketId và chuyển trạng thái SOLD (Ticket.sellTicket).&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;–&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;" vertex="1" parent="1"><mxGeometry x="984" y="150" width="820" height="178" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pl79n1-d" name="UCD - Khoa"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pl79n1-24" value="BuyerTicketMVC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeWidth=2;verticalAlign=top;align=center;fontStyle=1;fontSize=16;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="330" y="150" width="836" height="1114" as="geometry"/></mxCell><mxCell id="pl79n1-1" value="Use Case Diagram – Đặng Đăng Khoa (nhánh dang-dang-khoa) – Buyer (BuyerTicketMVC)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1600" height="34" as="geometry"/></mxCell><mxCell id="pl79n1-2" value="Căn cứ: menu MainView.showMenu (1–7) được Main điều phối và các Controller: MatchController (searchByName, searchByDate, viewMatch), SeatController (viewSeatMap, selectSeat, unselectSeat), OrderController (createOrder, confirmOrder, viewPurchaseHistory), TicketController (createTicket, viewTicket), CancellationController (createRequest, viewStatus)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#b7a35a;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="760" height="60" as="geometry"/></mxCell><mxCell id="pl79n1-3" value="Chức năng lớn 1: Tìm kiếm trận đấu" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;fillColor=#f9fbff;strokeColor=#8aa7cf;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#1f4e8c;" vertex="1" parent="1"><mxGeometry x="360" y="200" width="504" height="226" as="geometry"/></mxCell><mxCell id="pl79n1-4" value="Tìm kiếm trận đấu" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#b1d0f5;strokeColor=#3a6db0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="380" y="230" width="172" height="52" as="geometry"/></mxCell><mxCell id="pl79n1-5" value="Tìm theo tên" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="672" y="294" width="172" height="52" as="geometry"/></mxCell><mxCell id="pl79n1-6" value="Tìm theo ngày" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="672" y="358" width="172" height="52" as="geometry"/></mxCell><mxCell id="pl79n1-7" value="Chức năng lớn 2: Thông tin trận &amp; sân" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;fillColor=#f9fbff;strokeColor=#8aa7cf;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#1f4e8c;" vertex="1" parent="1"><mxGeometry x="360" y="444" width="298" height="162" as="geometry"/></mxCell><mxCell id="pl79n1-8" value="Xem thông tin trận đấu" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="474" width="172" height="52" as="geometry"/></mxCell><mxCell id="pl79n1-9" value="Xem sơ đồ sân" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="538" width="172" height="52" as="geometry"/></mxCell><mxCell id="pl79n1-10" value="Chức năng lớn 3: Chọn ghế &amp; tạo đơn" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;fillColor=#f9fbff;strokeColor=#8aa7cf;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#1f4e8c;" vertex="1" parent="1"><mxGeometry x="360" y="624" width="504" height="226" as="geometry"/></mxCell><mxCell id="pl79n1-11" value="Chọn ghế &amp; tạo đơn hàng" style="ellipse;whiteSpace=wrap;html=1;