ometry"/></mxCell><mxCell id="ponouc-20" value="Xem hồ sơ" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="672" y="1220" width="172" height="52" as="geometry"/></mxCell><mxCell id="ponouc-21" value="Cập nhật hồ sơ" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="672" y="1284" width="172" height="52" as="geometry"/></mxCell><mxCell id="ponouc-22" value="Đổi mật khẩu" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="672" y="1348" width="172" height="52" as="geometry"/></mxCell><mxCell id="ponouc-23" value="Nhập dữ liệu ghế, khu, sân, người dùng" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="954" y="244" width="172" height="52" as="geometry"/></mxCell><mxCell id="ponouc-24" value="Thanh toán" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="954" y="326" width="172" height="52" as="geometry"/></mxCell><mxCell id="ponouc-25" value="Phát hành vé QR" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="954" y="408" width="172" height="52" as="geometry"/></mxCell><mxCell id="ponouc-26" value="Tạo booking" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="954" y="490" width="172" height="52" as="geometry"/></mxCell><mxCell id="ponouc-27" value="Giữ ghế (lock + seat hold)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="954" y="572" width="172" height="52" as="geometry"/></mxCell><mxCell id="ponouc-28" value="Xử lý &amp; xác minh giao dịch" style="ellipse;whiteSp