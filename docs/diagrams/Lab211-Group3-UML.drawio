lBackgroundColor=#ffffff;" edge="1" parent="1" source="pv9a8r-70" target="pv9a8r-65"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pv9a8r-208" value="«extend»" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;fontSize=10;fontColor=#8a3b00;strokeColor=#d06a00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pv9a8r-71" target="pv9a8r-65"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pv9a8r-209" value="«extend»" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;fontSize=10;fontColor=#8a3b00;strokeColor=#d06a00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pv9a8r-74" target="pv9a8r-73"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pv9a8r-210" value="«extend»" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;fontSize=10;fontColor=#8a3b00;strokeColor=#d06a00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pv9a8r-75" target="pv9a8r-73"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pv9a8r-211" value="«extend»" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;fontSize=10;fontColor=#8a3b00;strokeColor=#d06a00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pv9a8r-76" target="pv9a8r-73"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pv9a8r-212" value="«extend»" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;fontSize=10;fontColor=#8a3b00;strokeColor=#d06a00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pv9a8r-77" target="pv9a8r-73"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pv9a8r-213" value="«extend»" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;fontSize=10;fontColor=#8a3b00;strokeColor=#d06a00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pv9a8r-78" target="pv9a8r-73"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pv9a8r-214" value="«extend»" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;fontSize=10;fontColor=#8a3b00;strokeColor=#d06a00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pv9a8r-79" target="pv9a8r-73"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pv9a8r-215" value="«extend»" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;fontSize=10;fontColor=#8a3b00;strokeColor=#d06a00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pv9a8r-86" target="pv9a8r-85"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pv9a8r-216" value="«extend»" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;fontSize=10;fontColor=#8a3b00;strokeColor=#d06a00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pv9a8r-87" target="pv9a8r-85"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pv9a8r-217" value="«extend»" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;fontSize=10;fontColor=#8a3b00;strokeColor=#d06a00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pv9a8r-95" target="pv9a8r-94"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pv9a8r-218" value="«extend»" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;fontSize=10;fontColor=#8a3b00;strokeColor=#d06a00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pv9a8r-96" target="pv9a8r-94"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pv9a8r-219" value="«extend»" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;fontSize=10;fontColor=#8a3b00;strokeColor=#d06a00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pv9a8r-97" target="pv9a8r-94"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pv9a8r-220" value="«extend»" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;fontSize=10;fontColor=#8a3b00;strokeColor=#d06a00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pv9a8r-98" target="pv9a8r-94"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pv9a8r-221" value="«extend»
[hết thời gian giữ ghế]" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;fontSize=10;fontColor=#8a3b00;strokeColor=#d06a00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pv9a8r-112" target="pv9a8r-109"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pv9a8r-222" value="&lt;div style=&quot;font-size:11px;&quot;&gt;&lt;div style=&quot;font-size:14px;font-weight:bold;margin-bottom:4px;&quot;&gt;Mô tả các chức năng lớn (use case chính)&lt;/div&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;&quot;&gt;&lt;tr style=&quot;background:#dae8fc;&quot;&gt;&lt;th style=&quot;border:1px solid #999;padding:3px;&quot;&gt;Chức năng (use case)&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:3px;&quot;&gt;Tác nhân&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:3px;&quot;&gt;Mô tả&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:3px;&quot;&gt;Use case con / quan hệ&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;&lt;b&gt;Đăng nhập / Đăng xuất&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Khách, Người dùng&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Xác thực username + mật khẩu (SHA-256) trong users.csv; tài khoản phải ACTIVE. Thành công thì chuyển sang controller theo vai trò; mọi lần đăng nhập/đăng xuất được ghi nhật ký.&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;–&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;&lt;b&gt;Đăng ký tài khoản Buyer&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Khách&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Tạo tài khoản Buyer mới.&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;include: Kiểm tra thông tin tài khoản (username/email không trùng, mật khẩu ≥ 6, SĐT hợp lệ)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;&lt;b&gt;Quản lý hồ sơ cá nhân&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Người dùng&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Mỗi vai trò tự xem/sửa hồ sơ và đổi mật khẩu.&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;extend: Xem hồ sơ, Cập nhật hồ sơ, Đổi mật khẩu&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;&lt;b&gt;Xem thông báo&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Người dùng&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Xem thông báo (đăng nhập, thanh toán, hủy vé...) rồi đánh dấu đã đọc.&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;–&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;&lt;b&gt;Quản lý người dùng&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Admin&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;CRUD tài khoản: xem, tìm, tạo Seller, sửa, khóa/mở khóa, xóa mềm (DELETED, giữ lịch sử).&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;extend: 6 chức năng con; Tạo Seller include Kiểm tra thông tin tài khoản&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;&lt;b&gt;Quản lý sân / khu vực / ghế&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Admin&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;CRUD sân, khu vực, ghế. Xóa chỉ khi chưa có trận/vé tham chiếu; tổng sức chứa khu vực ≤ sức chứa sân.&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;extend: các chức năng con; Bảo trì/Khóa ghế include Dừng bán vé của ghế&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;&lt;b&gt;Quản lý đội bóng&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Admin&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;CRUD đội bóng (tên không trùng, không xóa đội đang có trận).&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;extend: Xem, Thêm, Sửa, Xóa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;&lt;b&gt;Giám sát hệ thống&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Admin&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Xem toàn bộ trận, booking, thanh toán, giao dịch cổng thanh toán, nhật ký hệ thống.&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;extend: 5 chức năng xem&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;&lt;b&gt;Xử lý yêu cầu hủy vé&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Admin&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Duyệt (hủy e-ticket, trả ghế về kho bán, hoàn tiền) hoặc từ chối yêu cầu của Buyer.&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Duyệt include Hoàn tiền&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;&lt;b&gt;Kiểm thử Double Booking&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Admin&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Cho 2 Buyer cùng giữ 1 ghế đồng thời: chỉ 1 người thành công (optimistic locking).&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;include: Giữ ghế&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;&lt;b&gt;Xem báo cáo doanh thu&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Admin, Seller&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Tổng vé, đã bán, đang giữ, doanh thu, đã hoàn tiền theo trận.&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;–&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;&lt;b&gt;Quản lý trận đấu&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Seller&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;CRUD trận của chính Seller, mở/đóng bán vé.&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Thêm/Sửa include Kiểm tra trùng lịch&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;&lt;b&gt;Quản lý vé mở bán&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Seller&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Tạo vé theo ghế hoặc cả khu, sửa giá/loại, dừng/mở bán, xóa vé chưa từng được đặt.&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;extend: 6 chức năng con&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;&lt;b&gt;Bán vé tại quầy / Soát vé / Lịch sử bán&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Seller&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Bán vé tiền mặt cho Buyer; check-in bằng mã QR (ACTIVE → USED); xem các booking đã xử lý.&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Bán tại quầy include Giữ ghế, Xử lý thanh toán, Phát hành vé&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;&lt;b&gt;Tìm kiếm / xem trận / sơ đồ sân&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Buyer&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Tìm trận theo tên hoặc ngày, xem chi tiết trận và sơ đồ ghế (trống / giữ / đã bán).&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;extend: Tìm theo tên, Tìm theo ngày&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;&lt;b&gt;Chọn ghế &amp;amp; đặt vé&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Buyer&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Chọn tối đa 4 ghế; mỗi ghế được giữ 5 phút trong booking PENDING.&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;include: Giữ ghế (Tự động trả ghế hết hạn extend Giữ ghế)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;&lt;b&gt;Quản lý booking chờ thanh toán&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Buyer, Cổng thanh toán&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Thanh toán (VNPAY/MOMO/...), gia hạn giữ ghế 1 lần, bỏ chọn ghế, hủy booking.&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Thanh toán include Xử lý thanh toán, Phát hành vé điện tử&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;&lt;b&gt;Vé, lịch sử, hủy vé&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Buyer&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Xem lịch sử đặt vé, e-ticket kèm QR; gửi và theo dõi yêu cầu hủy vé.&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;–&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;" vertex="1" parent="1"><mxGeometry x="1668" y="164" width="820" height="868" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5ybo0-d" name="UCD - Nhật"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p5ybo0-14" value="Stadium Ticket Booking – phân hệ Admin" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeWidth=2;verticalAlign=top;align=center;fontStyle=1;fontSize=16;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="330" y="150" width="574" height="754" as="geometry"/></mxCell><mxCell id="p5ybo0-1" value="Use Case Diagram – Hồ Lê Hoàng Nhật (nhánh ho-le-hoang-nhat) – Admin" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1600" height="34" as="geometry"/></mxCell><mxCell id="p5ybo0-2" value="Căn cứ: menu AdminView.displayMenu() (1–5, 0) và các hàm AdminController: getAllUsers, changeUserStatus, getAllStadiums, createStadium, updateSeatMaintenance. (getAllSeats có trong Controller nhưng không có use case nào gọi tới.)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#b7a35a;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="760" height="60" as="geometry"/></mxCell><mxCell id="p5ybo0-3" value="Chức năng lớn 1: Quản lý người dùng" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;fillColor=#f9fbff;strokeColor=#8aa7cf;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#1f4e8c;" vertex="1" parent="1"><mxGeometry x="360" y="200" width="504" height="226" as="geometry"/></mxCell><mxCell id="p5ybo0-4" value="Quản lý người dùng" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#b1d0f5;strokeColor=#3a6db0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="380" y="230" width="172" height="52" as="geometry"/></mxCell><mxCell id="p5ybo0-5" value="Xem danh sách người dùng &amp; Seller" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="672" y="294" width="172" height="52" as="geometry"/></mxCell><mxCell id="p5ybo0-6" value="Khóa / Mở khóa tài khoản" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="672" y="358" width="172" height="52" as="geometry"/></mxCell><mxCell id="p5ybo0-7" value="Chức năng lớn 2: Quản lý sân vận động" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;fillColor=#f9fbff;strokeColor=#8aa7cf;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#1f4e8c;" vertex="1" parent="1"><mxGeometry x="360" y="444" width="504" height="226" as="geometry"/></mxCell><mxCell id="p5ybo0-8" value="Quản lý sân vận động" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#b1d0f5;strokeColor=#3a6db0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="380" y="474" width="172" height="52" as="geometry"/></mxCell><mxCell id="p5ybo0-9" value="Xem danh sách sân vận động" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="672" y="538" width="172" height="52" as="geometry"/></mxCell><mxCell id="p5ybo0-10" value="Thêm sân vận động mới" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="672" y="602" width="172" height="52" as="geometry"/></mxCell><mxCell id="p5ybo0-11" value="Chức năng lớn 3: Quản lý ghế" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;fillColor=#f9fbff;strokeColor=#8aa7cf;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#1f4e8c;" vertex="1" parent="1"><mxGeometry x="360" y="688" width="504" height="162" as="geometry"/></mxCell><mxCell id="p5ybo0-12" value="Quản lý ghế" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#b1d0f5;strokeColor=#3a6db0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="380" y="718" width="172" height="52" as="geometry"/></mxCell><mxCell id="p5ybo0-13" value="Quản lý trạng thái ghế (bảo trì / mở)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="672" y="782" width="172" height="52" as="geometry"/></mxCell><mxCell id="p5ybo0-15" value="Admin" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="120" y="485" width="46" height="80" as="geometry"/></mxCell><mxCell id="p5ybo0-16" value="" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1" source="p5ybo0-15" target="p5ybo0-4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5ybo0-17" value="" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1" source="p5ybo0-15" target="p5ybo0-8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5ybo0-18" value="" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1" source="p5ybo0-15" target="p5ybo0-12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5ybo0-19" value="«extend»" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;fontSize=10;fontColor=#8a3b00;strokeColor=#d06a00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5ybo0-5" target="p5ybo0-4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5ybo0-20" value="«extend»" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;fontSize=10;fontColor=#8a3b00;strokeColor=#d06a00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5ybo0-6" target="p5ybo0-4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5ybo0-21" value="«extend»" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;fontSize=10;fontColor=#8a3b00;strokeColor=#d06a00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5ybo0-9" target="p5ybo0-8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5ybo0-22" value="«extend»" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;fontSize=10;fontColor=#8a3b00;strokeColor=#d06a00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5ybo0-10" target="p5ybo0-8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5ybo0-23" value="«extend»" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;fontSize=10;fontColor=#8a3b00;strokeColor=#d06a00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5ybo0-13" target="p5ybo0-12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5ybo0-24" value="&lt;div style=&quot;font-size:11px;&quot;&gt;&lt;div style=&quot;font-size:14px;font-weight:bold;margin-bottom:4px;&quot;&gt;Mô tả use case&lt;/div&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;&quot;&gt;&lt;tr style=&quot;background:#dae8fc;&quot;&gt;&lt;th style=&quot;border:1px solid #999;padding:3px;&quot;&gt;Chức năng (use case)&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:3px;&quot;&gt;Tác nhân&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:3px;&quot;&gt;Mô tả&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:3px;&quot;&gt;Use case con / quan hệ&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;&lt;b&gt;Quản lý người dùng&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Admin&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Đọc users.csv để liệt kê; đổi trạng thái ACTIVE/LOCKED theo User ID (UserRepository.updateUserStatus).&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;extend: Xem danh sách, Khóa/Mở khóa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;&lt;b&gt;Quản lý sân vận động&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Admin&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Liệt kê sân từ stadiums.csv; thêm sân mới (id, tên, địa chỉ, sức chứa) qua StadiumRepository.add.&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;extend: Xem danh sách, Thêm sân&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;&lt;b&gt;Quản lý ghế&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Admin&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Chuyển ghế sang MAINTENANCE hoặc AVAILABLE, tăng version (SeatRepository.updateStatus).&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;extend: Quản lý trạng thái ghế&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;" vertex="1" parent="1"><mxGeometry x="984" y="150" width="820" height="178" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pra6ux-d" name="UCD - Minh"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pra6ux-12" value="Stadium Ticket Booking – Đăng nhập &amp; Đặt vé" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeWidth=2;verticalAlign=top;align=center;fontStyle=1;fontSize=16;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="330" y="150" width="836" height="510" as="geometry"/></mxCell><mxCell id="pra6ux-1" value="Use Case Diagram – Ngô Phạm Nguyệt Minh (nhánh ngo-pham-nguyet-minh) – Đăng nhập, thông báo, đặt vé" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1600" height="34" as="geometry"/></mxCell><mxCell id="pra6ux-2" value="Căn cứ: view.Main (đăng nhập → ReportView.displayUserDashboard → MainController.triggerNotification → BookingView.showBookingMenu), BookingView (1. Xem sơ đồ ghế, 2. Chọn ghế và đặt vé) và Integration/view/Main. Các lớp User, AuditLog, ReportView.displayNotificationBanner chưa được gọi nên không sinh use case." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#b7a35a;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="760" height="60" as="geometry"/></mxC