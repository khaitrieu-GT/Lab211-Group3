endArrow=open;endFill=0;startArrow=diamondThin;startFill=0;startSize=14;html=1;fontSize=9;strokeColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pfj3ao-47" target="pfj3ao-48"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pfj3ao-78" value="seats *" style="endArrow=open;endFill=0;startArrow=diamondThin;startFill=0;startSize=14;html=1;fontSize=9;strokeColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pfj3ao-48" target="pfj3ao-42"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pfj3ao-79" value="«create» Seat, Zone, Stadium, User, Booking, ..." style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=9;strokeColor=#1565c0;fontColor=#1565c0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pfj3ao-4" target="pfj3ao-38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pfj3ao-80" value="«use»" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pfj3ao-38" target="pfj3ao-49"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pfj3ao-81" value="&lt;b&gt;Chú thích quan hệ&lt;/b&gt;&lt;br&gt;— ▷ (nét liền, tam giác rỗng): kế thừa (extends)&lt;br&gt;- - ▷ (nét đứt, tam giác rỗng): hiện thực (implements)&lt;br&gt;◇—&gt; : tập hợp (aggregation) &amp;nbsp; ◆—&gt; : hợp thành (composition)&lt;br&gt;—&gt; : liên kết (association, giữ tham chiếu)&lt;br&gt;- - -&gt; «create»: tạo đối tượng &amp;nbsp; - - -&gt; «use»: phụ thuộc / gọi&lt;br&gt;⊕— : lớp lồng (nested class)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#b7a35a;" vertex="1" parent="1"><mxGeometry x="1070" y="50" width="380" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="puw8np-d" name="Sequence - Toàn dự án"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="puw8np-1" value="Sequence Diagram – Toàn bộ dự án (nhánh main)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1800" height="34" as="geometry"/></mxCell><mxCell id="puw8np-2" value="Gồm 4 luồng chính: (1) Khởi động – đăng nhập – điều hướng theo vai trò, (2) Buyer chọn ghế – giữ ghế – thanh toán – nhận e-ticket, (3) Seller tạo trận – tạo vé – mở bán, (4) Buyer gửi yêu cầu hủy vé &amp; Admin duyệt – hoàn tiền. Màu: xanh dương = View, xanh lá = Controller, vàng = Model, cam = Repository, tím = Service." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#b7a35a;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="900" height="60" as="geometry"/></mxCell><mxCell id="puw8np-3" value="sd 1. Khởi động hệ thống, đăng nhập / đăng ký và điều hướng theo vai trò" style="shape=umlFrame;whiteSpace=wrap;html=1;width=519.5999999999999;height=24;boundedLbl=1;verticalAlign=middle;align=left;spacingLeft=6;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="2005" height="1468" as="geometry"/></mxCell><mxCell id="puw8np-4" value="" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;" vertex="1" parent="1"><mxGeometry x="132" y="190" width="36" height="1408" as="geometry"/></mxCell><mxCell id="puw8np-5" value="Người dùng" style="text;html=1;fontSize=11;fontStyle=1;align=center;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="90" y="242" width="120" height="18" as="geometry"/></mxCell><mxCell id="puw8np-6" value="Main" style="shape=