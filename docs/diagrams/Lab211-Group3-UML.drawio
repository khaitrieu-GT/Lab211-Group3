oseSale, createTicket, updateTicket, getTickets, sellTicket). Nhánh không có lớp Main nên menu chưa được nối với Controller." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#b7a35a;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="760" height="60" as="geometry"/></mxCell><mxCell id="pweljn-3" value="Chức năng lớn 1: Quản lý trận đấu" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;fillColor=#f9fbff;strokeColor=#8aa7cf;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#1f4e8c;" vertex="1" parent="1"><mxGeometry x="360" y="200" width="504" height="482" as="geometry"/></mxCell><mxCell id="pweljn-4" value="Quản lý trận đấu" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#b1d0f5;strokeColor=#3a6db0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="380" y="230" width="172" height="52" as="geometry"/></mxCell><mxCell id="pweljn-5" value="Thêm trận đấu" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="672" y="294" width="172" height="52" as="geometry"/></mxCell><mxCell id="pweljn-6" value="Xem danh sách trận" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="672" y="358" width="172" height="52" as="geometry"/></mxCell><mxCell id="pweljn-7" value="Sửa trận đấu" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="672" y="422" width="172" height="52" as="geometry"/></mxCell><mxCell id="pweljn-8" value="Xóa trận đấu" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="672" y="486" width="172" height="52" as="geometry"/></mxCell><mxCell id="pweljn-9" value="Mở bán vé" style="ellipse;whiteSpace=wra