-54" value="«extend»" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;fontSize=10;fontColor=#8a3b00;strokeColor=#d06a00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ponouc-20" target="ponouc-19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ponouc-55" value="«extend»" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;fontSize=10;fontColor=#8a3b00;strokeColor=#d06a00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ponouc-21" target="ponouc-19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ponouc-56" value="«extend»" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;fontSize=10;fontColor=#8a3b00;strokeColor=#d06a00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ponouc-22" target="ponouc-19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ponouc-57" value="&lt;div style=&quot;font-size:11px;&quot;&gt;&lt;div style=&quot;font-size:14px;font-weight:bold;margin-bottom:4px;&quot;&gt;Mô tả use case&lt;/div&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;&quot;&gt;&lt;tr style=&quot;background:#dae8fc;&quot;&gt;&lt;th style=&quot;border:1px solid #999;padding:3px;&quot;&gt;Chức năng (use case)&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:3px;&quot;&gt;Tác nhân&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:3px;&quot;&gt;Mô tả&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:3px;&quot;&gt;Use case con / quan hệ&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;&lt;b&gt;Đặt vé&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Buyer&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Nhập dữ liệu, tạo booking (CreateBookingCommand), khóa ghế + tạo phiên giữ, thanh toán, phát hành vé QR.&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;include: 5 chức năng; Xác nhận booking extend khi thanh toán thành công&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;&lt;b&gt;Thanh toán&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Buyer, Cổng thanh toán&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;CreatePayment → ProcessTransaction → VerifyTransaction → UpdatePaymentStatus(SUCCESS).&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;include: Xử lý &amp;amp; xác minh giao dịch&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;&lt;b&gt;Kiểm thử Double Booking&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Buyer&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Booking thứ hai khóa lại cùng ghế: Seat.lock ném lỗi → bị chặn.&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;include: Tạo booking, Giữ ghế&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;&lt;b&gt;Quản lý booking / vé / hồ sơ&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Buyer&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Các Command: CancelBooking, ExtendHold, ReleaseHold/ReleaseBookingSeat/UnlockSeat, CancelTicket, RefundPayment, UpdateProfile, ChangePassword.&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;extend: các chức năng con&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;" vertex="1" parent="1"><mxGeometry x="1668" y="164" width="820" height="224" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pvtwo6-d" name="MVC - Toàn dự án"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pvtwo6-1" value="MVC Diagram – Toàn bộ dự án (nhánh main): Main → MainController → Controller theo vai trò → View / Model" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1800" height="34" as="geometry"/></mxCell><mxCell id="pvtwo6-2" value="Luồng chạy từ Controller: Main tạo MainController; MainController điều khiển MainView và mở AdminController / SellerController / BuyerController theo vai trò. Controller lấy dữ liệu nhập từ View, gọi Controller nghiệp vụ / Service / Repository / Command để thao tác Model, rồi đưa kết quả cho View hiển thị. View KHÔNG gọi Controller. Quan hệ Controller → Repository / Service / Command được vẽ ở mức gói để sơ đồ dễ đọc. Đủ 114 lớp / interface / enum có trong src (kể cả lớp lồng BookingController.PaymentResult, SalesReport.Line)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#b7a35a;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1100" height="84" as="geometry"/></mxCell><mxCell id="pvtwo6-17" value="VIEW – giao diện console (chỉ nhập / xuất)" style="rounded=1;arcSize=2;whiteSpace=nowrap;html=1;fillColor=#e8f0fb;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=16;fontStyle=1;opacity=50;" vertex="1" parent="1"><mxGeometry x="40" y="158" width="1402" height="427" as="geometry"/></mxCell><mxCell id="pvtwo6-3" value="package view – lớp cơ sở" style="shape=folder;tabWidth=188;tabHeight=20;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=0;fontStyle=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=60;" vertex="1" parent="1"><mxGeometry x="70" y="198" width="350" height="367" as="geometry"/></mxCell><mxCell id="pvtwo6-4" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«abstract»&lt;/i&gt;&lt;br&gt;&lt;b&gt;BaseView&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0 0 0 6px;font-size:10px;&quot;&gt;+ printHeader()&lt;br&gt;+ printSection()&lt;br&gt;+ printList()&lt;br&gt;+ printSuccess()&lt;br&gt;+ printError()&lt;br&gt;+ showMessage()&lt;br&gt;+ withUnread()&lt;br&gt;+ inputChoice()&lt;br&gt;+ inputString()&lt;br&gt;+ inputNonEmpty()&lt;br&gt;+ inputId()&lt;br&gt;+ inputInt()&lt;br&gt;+ inputIntInRange()&lt;br&gt;+ inputMoney()&lt;br&gt;+ inputOptionalMoney()&lt;br&gt;+ inputDate()&lt;br&gt;+ inputOptionalDate()&lt;br&gt;+ inputTime()&lt;br&gt;+ inputOptionalTime()&lt;br&gt;+ confirm()&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="90" y="232" width="146" height="315" as="geometry"/></mxCell><mxCell id="pvtwo6-5" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«singleton»&lt;/i&gt;&lt;br&gt;&lt;b&gt;ConsoleInput&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0 0 0 6px;font-size:10px;&quot;&gt;+ getInstance()&lt;br&gt;+ readString()&lt;br&gt;+ readNonEmpty()&lt;br&gt;+ readInt()&lt;br&gt;+ readIntInRange()&lt;br&gt;+ readMoney()&lt;br&gt;+ readOptionalMoney()&lt;br&gt;+ readDate()&lt;br&gt;+ readOptionalDate()&lt;br&gt;+ readTime()&lt;br&gt;+ readOptionalTime()&lt;br&gt;+ readYesNo()&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="260" y="232" width="140" height="209" as="geo