5;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pvtwo6-42" target="pvtwo6-58"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pvtwo6-210" value="«create»" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=9;strokeColor=#1565c0;fontColor=#1565c0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pvtwo6-26" target="pvtwo6-124"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pvtwo6-211" value="«create»" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=9;strokeColor=#1565c0;fontColor=#1565c0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pvtwo6-92" target="pvtwo6-124"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pvtwo6-212" value="&lt;b&gt;Chú thích quan hệ&lt;/b&gt;&lt;br&gt;— ▷ (nét liền, tam giác rỗng): kế thừa (extends)&lt;br&gt;- - ▷ (nét đứt, tam giác rỗng): hiện thực (implements)&lt;br&gt;◇—&gt; : tập hợp (aggregation) &amp;nbsp; ◆—&gt; : hợp thành (composition)&lt;br&gt;—&gt; : liên kết (association, giữ tham chiếu)&lt;br&gt;- - -&gt; «create»: tạo đối tượng &amp;nbsp; - - -&gt; «use»: phụ thuộc / gọi&lt;br&gt;⊕— : lớp lồng (nested class)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#b7a35a;" vertex="1" parent="1"><mxGeometry x="1170" y="50" width="380" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pj358z-d" name="MVC - Nhật"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pj358z-1" value="MVC Diagram – Hồ Lê Hoàng Nhật (nhánh ho-le-hoang-nhat)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1800" height="34" as="geometry"/></mxCell><mxCell id="pj358z-2" value="Luồng: Main → AdminView.displayMenu() → AdminController → Repository (đọc/ghi CSV) → Model. Ở nhánh này View tạo và gọi Controller (luồng chạy từ View). SectionRepository là lớp rỗng; Section chưa được lớp nào sử dụng." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#b7a35a;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="900" height="60" as="geometry"/></mxCell><mxCell id="pj358z-7" value="VIEW – giao diện console (chỉ nhập / xuất)" style="rounded=1;arcSize=2;whiteSpace=nowrap;html=1;fillColor=#e8f0fb;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=16;fontStyle=1;opacity=50;" vertex="1" parent="1"><mxGeometry x="40" y="134" width="494" height="229" as="geometry"/></mxCell><mxCell id="pj358z-3" value="(default package)" style="shape=folder;tabWidth=139;tabHeight=20;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=0;fontStyle=1;fontSize=12;fillColor=#eeeeee;strokeColor=#333333;opacity=60;" vertex="1" parent="1"><mxGeometry x="70" y="174" width="170" height="103" as="geometry"/></mxCell><mxCell id="pj358z-4" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Main&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0 0 0 6px;font-size:10px;&quot;&gt;+ main(args)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="90" y="208" width="130" height="51" as="geometry"/></mxCell><mxCell id="pj358z-5" value="package view" style="shape=folder;tabWidth=104;tabHeight=20;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=0;fontStyle=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=60;" vertex="1" parent="1"><mxGeometry x="270" y