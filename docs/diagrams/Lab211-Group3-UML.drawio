[chọn N]" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;fontSize=10;fontColor=#8a3b00;strokeColor=#d06a00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pl79n1-13" target="pl79n1-11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pl79n1-42" value="&lt;div style=&quot;font-size:11px;&quot;&gt;&lt;div style=&quot;font-size:14px;font-weight:bold;margin-bottom:4px;&quot;&gt;Mô tả use case&lt;/div&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;&quot;&gt;&lt;tr style=&quot;background:#dae8fc;&quot;&gt;&lt;th style=&quot;border:1px solid #999;padding:3px;&quot;&gt;Chức năng (use case)&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:3px;&quot;&gt;Tác nhân&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:3px;&quot;&gt;Mô tả&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:3px;&quot;&gt;Use case con / quan hệ&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;&lt;b&gt;Tìm kiếm trận đấu&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Buyer&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Tìm trong danh sách trận theo tên hoặc theo ngày (MatchController).&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;extend: Tìm theo tên, Tìm theo ngày&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;&lt;b&gt;Xem thông tin trận / sơ đồ sân&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Buyer&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Hiển thị chi tiết trận và các khu vực, ghế của sân.&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;–&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;&lt;b&gt;Chọn ghế &amp;amp; tạo đơn hàng&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Buyer&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Xem sơ đồ, nhập hàng + số ghế, chọn ghế, tạo Order. Y: xác nhận đơn, ghế SOLD, phát hành vé. N: bỏ chọn ghế.&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;include: Xem sơ đồ sân, Chọn ghế, Tạo đơn; extend: Xác nhận, Bỏ chọn&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;&lt;b&gt;Xem lịch sử / vé điện tử&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Buyer&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Xem các Order của Buyer và vé vừa phát hành.&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;–&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;&lt;b&gt;Hủy vé&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Buyer&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;Gửi lý do hủy vé mới nhất (trạng thái PENDING) và xem trạng thái yêu cầu.&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;vertical-align:top;&quot;&gt;–&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;" vertex="1" parent="1"><mxGeometry x="1246" y="150" width="820" height="270" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="ponouc-d" name="UCD - Triệu"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ponouc-30" value="TV4 Booking Core" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeWidth=2;verticalAlign=top;align=center;fontStyle=1;fontSize=16;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="330" y="164" width="1078" height="1306" as="geometry"/></mxCell><mxCell id="ponouc-1" value="Use Case Diagram – Bùi Khải Triệu (nhánh bui-khai-trieu) – Lõi đặt vé (tv4-booking-core)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1600" height="34" as="geometry"/></mxCell><mxCell id="ponouc-2" value="Căn cứ: luồng 14 bước trong Main (nhập ghế/khu/sân/người dùng → booking → giữ ghế → thanh toán → giao dịch → xác nhận → vé → kiểm thử double booking) và 22 Command. Các command có trong code nhưng Main chưa gọi (Cancel*, Extend/Release*, Unlock, Refund, Update/Change*) vẫn là chức năng của hệ thống." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#b7a35a;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="760" height="74" as="geometry"/></mxCell><mxCell id="ponouc-3" value="Chức năng lớn 1: Đặt vé (luồng chính trong Main)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;fillColor=#f9fbff;strokeColor=#8aa7cf;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#1f4e8c;" vertex="1" parent="1"><mxGeometry x="360" y="214" width="504" height="162" as="geometry"/></mxCell><mxCell id="ponouc-4" value="Đặt vé" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#b1d0f5;strokeColor=#3a6db0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="380" y="244" width="172" height="52" as="geometry"/></mxCell><mxCell id="ponouc-5" value="Xác nhận booking (ghế SOLD)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="672" y="308" width="172" height="52" as="geometry"/></mxCell><mxCell id="ponouc-6" value="Chức năng lớn 2: Kiểm thử" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;fillColor=#f9fbff;strokeColor=#8aa7cf;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#1f4e8c;" vertex="1" parent="1"><mxGeometry x="360" y="394" width="212" height="98" as="geometry"/></mxCell><mxCell id="ponouc-7" value="Kiểm thử Double Booking" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#b1d0f5;strokeColor=#3a6db0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="380" y="424" width="172" height="52" as="geometry"/></mxCell><mxCell id="ponouc-8" value="Chức năng lớn 3: Quản lý booking &amp; giữ ghế" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;fillColor=#f9fbff;strokeColor=#8aa7cf;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#1f4e8c;" vertex="1" parent="1"><mxGeometry x="360" y="510" width="504" height="290" as="geometry"/></mxCell><mxCell id="ponouc-9" value="Quản lý booking" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#b1d0f5;strokeColor=#3a6db0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="380" y="540" width="172" height="52" as="geometry"/></mxCell><mxCell id="ponouc-10" value="Hủy booking" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="672" y="604" width="172" height="52" as="geometry"/></mxCell><mxCell id="ponouc-11" value="Gia hạn giữ ghế" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="672" y="668" width="172" height="52" as="geometry"/></mxCell><mxCell id="ponouc-12" value="Trả ghế (release seat / hold)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" ver