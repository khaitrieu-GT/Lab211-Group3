belBackgroundColor=#ffffff;" edge="1" parent="1" source="p7a9c0-25" target="p7a9c0-26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7a9c0-59" value="order" style="endArrow=open;endFill=0;html=1;fontSize=9;strokeColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p7a9c0-29" target="p7a9c0-26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7a9c0-60" value="ticket" style="endArrow=open;endFill=0;html=1;fontSize=9;strokeColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p7a9c0-28" target="p7a9c0-29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7a9c0-61" value="&lt;b&gt;Chú thích quan hệ&lt;/b&gt;&lt;br&gt;— ▷ (nét liền, tam giác rỗng): kế thừa (extends)&lt;br&gt;- - ▷ (nét đứt, tam giác rỗng): hiện thực (implements)&lt;br&gt;◇—&gt; : tập hợp (aggregation) &amp;nbsp; ◆—&gt; : hợp thành (composition)&lt;br&gt;—&gt; : liên kết (association, giữ tham chiếu)&lt;br&gt;- - -&gt; «create»: tạo đối tượng &amp;nbsp; - - -&gt; «use»: phụ thuộc / gọi&lt;br&gt;⊕— : lớp lồng (nested class)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#b7a35a;" vertex="1" parent="1"><mxGeometry x="970" y="50" width="380" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pfj3ao-d" name="MVC - Triệu"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pfj3ao-1" value="MVC Diagram – Bùi Khải Triệu (nhánh bui-khai-trieu, package com.tv4.booking)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1800" height="34" as="geometry"/></mxCell><mxCell id="pfj3ao-2" value="Nhánh không có lớp View/Controller riêng: Main vừa nhập/xuất console (vai trò View) vừa điều phối (vai trò Controller) bằng cách tạo Model và thực thi các Command. Mỗi Command đóng gói một thao tác nghiệp vụ trên một Model. RefundPaymentCommand là file thiếu đuôi .java (không được biên dịch)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#b7a35a;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1000" height="60" as="geometry"/></mxCell><mxCell id="pfj3ao-5" value="VIEW + CONTROLLER – Main (nhập / xuất console và điều phối)" style="rounded=1;arcSize=2;whiteSpace=nowrap;html=1;fillColor=#eef3ea;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=16;fontStyle=1;opacity=50;" vertex="1" parent="1"><mxGeometry x="40" y="134" width="260" height="163" as="geometry"/></mxCell><mxCell id="pfj3ao-3" value="package com.tv4.booking" style="shape=folder;tabWidth=181;tabHeight=20;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=0;fontStyle=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;opacity=60;" vertex="1" parent="1"><mxGeometry x="70" y="174" width="170" height="103" as="geometry"/></mxCell><mxCell id="pfj3ao-4" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Main&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0 0 0 6px;font-size:10px;&quot;&gt;+ main(args)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="90" y="208" width="130" height="51" as="geometry"/></mxCell><mxCell id="pfj3ao-37" value="CONTROLLER – Command Pattern (nhóm theo Model bị tác động)" style="rounded=1;arcSize=2;whiteSpace=nowrap;html=1;fillColor=#fbecec;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=16;fontStyle=1;opacity=5