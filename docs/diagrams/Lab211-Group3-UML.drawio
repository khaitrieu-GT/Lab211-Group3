<mxfile host="app.diagrams.net" agent="Lab211-Group3 generator" version="24.7.17"><diagram id="pv9a8r-d" name="UCD - Toàn dự án"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pv9a8r-114" value="Stadium Ticket Booking System" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeWidth=2;verticalAlign=top;align=center;fontStyle=1;fontSize=16;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="330" y="164" width="1078" height="6440" as="geometry"/></mxCell><mxCell id="pv9a8r-1" value="Use Case Diagram – Toàn bộ dự án (Stadium Ticket Booking System – nhánh main)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1600" height="34" as="geometry"/></mxCell><mxCell id="pv9a8r-2" value="Căn cứ: các menu do Controller điều khiển (MainController, AdminController, SellerController, BuyerController, ProfileController) và các hàm nghiệp vụ được gọi tới. Use case xanh đậm = chức năng lớn; xanh nhạt = chức năng con (&lt;&lt;extend&gt;&gt; về chức năng lớn: là lựa chọn trong menu); tím = chức năng dùng chung luôn được thực hiện bên trong chức năng khác (&lt;&lt;include&gt;&gt;). Mũi tên &lt;&lt;include&gt;&gt;: từ use case cơ sở → use case được bao gồm. Mũi tên &lt;&lt;extend&gt;&gt;: từ use case mở rộng → use case cơ sở." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#b7a35a;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="760" height="74" as="geometry"/></mxCell><mxCell id="pv9a8r-3" value="Chức năng lớn 1: Xác thực tài khoản" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;fillColor=#f9fbff;strokeColor=#8aa7cf;verticalAlign=top;align=left;spacingLeft=8;spacingT